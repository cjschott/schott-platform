# Local environment files and secrets — never commit real values.
# Only sanitized *.env.example templates are tracked.
.env
.env.*
!.env.example
secrets/

# Runtime artifacts
logs/
backups/
*.log

# Model data (Ollama blobs live outside Git, in a Docker volume or host path)
models/
data/
**/.ollama/

# Superpowers tooling state
.superpowers/

# Generated validation / config output
validation-output/
*.rendered.yaml

# Python bytecode. This repository now ships Python tooling; compiled
# artifacts are build output and must never be committed.
__pycache__/
*.py[cod]

# Observation stores. Generated evidence, verifications, and knowledge events
# live outside version control: they would swamp the declared model, and
# committing an append-only record creates an editable second copy of
# something whose whole value is that it cannot be edited.
observations-local/
observations-test/
*.observation-store/

# Disposable integrity artefacts (snapshots, twins, reports, plans) live in an
# explicit data root outside the repository and are never tracked.
integrity-local/
integrity-test/

# Experience records (profiles, windows, baselines) live in an explicit data
# root outside the repository and are never tracked.
experience-local/
experience-test/
