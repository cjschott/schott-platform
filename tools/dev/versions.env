# Pinned development toolchain for the Schott Platform.
#
# Sourced by tools/dev/*.sh. This is the single source of truth for tool
# versions: a second copy of a version string is a second place to forget to
# update.
#
# Every pin below is traced to evidence. Nothing here is a guess, and a pin
# must not be changed without recording where the new value came from.
#
# Each pin declares its kind:
#
#   exact         must match precisely; a different version is an error
#   minimum       this version or newer
#   CI-aligned    must match what .github/workflows runs
#   host-observed recorded from the schai host; the only version validated
#
# Shell-safe assignments only. This file is sourced, so it must contain no
# command substitution and no logic.

# --- ShellCheck ------------------------------------------------------------
# Kind: CI-aligned (also exact).
# Evidence: .github/workflows/shellcheck.yml runs the ShellCheck preinstalled
# on ubuntu-24.04 and prints its version. CI run 30723148728 on main reported
# "version: 0.9.0". CI does not pin this itself, so local tooling pins the
# observed value and fails if a different version is used — otherwise local and
# CI could disagree about findings without anyone noticing.
SHELLCHECK_VERSION=0.9.0

# Container image used to obtain the pinned ShellCheck without installing a
# host package. Digest-pinned so the tag cannot be repointed underneath us.
SHELLCHECK_IMAGE=koalaman/shellcheck:v0.9.0

# --- Python ----------------------------------------------------------------
# Kind: minimum.
# Evidence: CI runs on ubuntu-24.04, which ships Python 3.12; the schai host
# reports 3.12.3. Nothing in this repository requires a 3.13 feature.
PYTHON_MIN_VERSION=3.12

# --- PyYAML ----------------------------------------------------------------
# Kind: exact.
# Evidence: requirements-ci.txt pins pyyaml==6.0.3 with published sha256
# hashes and installs it with --require-hashes. This value must equal that one;
# tests/test-developer-experience.sh compares them.
#
# Note: a host may legitimately carry a different 6.0.x build from its distro
# packages. That is reported as a parity warning by check-toolchain.sh and as
# an error under --strict, which is what run-local-ci.sh uses — claiming CI
# parity while running a different library build would be a false claim.
PYYAML_VERSION=6.0.3

# --- Docker Compose --------------------------------------------------------
# Kind: minimum.
# Evidence: CLAUDE.md mandates Docker Compose v2 as the orchestration
# interface, and .github/workflows/ci.yml notes that ubuntu-24.04 ships it.
# The schai host reports v5.3.1. The floor is v2 because that is the documented
# architectural requirement; the host version is recorded separately below.
DOCKER_COMPOSE_MIN_VERSION=2.0.0

# Kind: host-observed. Recorded for reference, not enforced.
DOCKER_COMPOSE_HOST_OBSERVED=5.3.1

# --- Git -------------------------------------------------------------------
# Kind: host-observed, enforced as a minimum.
# Evidence: the schai host reports git 2.43.0, and ubuntu-24.04 ships 2.43.x.
# The suites use `git ls-files` pathspecs, `git check-ignore -q`, and
# `git status --porcelain=v1 --untracked-files=all`, all of which predate this
# version — but 2.43.0 is the only version this repository has actually been
# validated against, so that is what is recorded rather than a lower bound
# nobody has tested.
GIT_MIN_VERSION=2.43.0

# --- Pinned dependency install --------------------------------------------
# The one approved way to install Python dependencies. Referenced in error
# messages so a failure always names its own remedy.
PINNED_PIP_INSTALL="python3 -m pip install --require-hashes -r requirements-ci.txt"
