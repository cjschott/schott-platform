# Ollama service — non-secret settings only.
# Copy to a local `.env` (never committed) and adjust as needed.

# Container timezone.
TZ=America/Chicago

# Pinned Ollama image. Change deliberately and re-test; avoid unbounded 'latest'.
OLLAMA_IMAGE=ollama/ollama:0.11.4

# Optional host bind address for the isolated troubleshooting port.
# Defaults to localhost. Do NOT set to 0.0.0.0 in this isolated stack — the
# integrated stack (ai/compose.yaml) keeps Ollama private with no host port.
OLLAMA_BIND_ADDRESS=127.0.0.1
