# LiteLLM gateway — non-secret settings, plus a REQUIRED master-key placeholder.
# Copy to a local `.env` (kept outside Git) and set a strong, unique master key.

# Container timezone.
TZ=America/Chicago

# Pinned LiteLLM image. Confirm/update against a tested release before deploy.
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-v1.74.3-stable

# Internal Ollama backend URL — private Docker network hostname. This is NOT an
# application endpoint; applications use the LiteLLM gateway on port 4000.
OLLAMA_BASE_URL=http://ollama:11434

# Published OpenAI-compatible gateway port.
LITELLM_PORT=4000

# Optional host bind address for the published port.
LITELLM_BIND_ADDRESS=0.0.0.0

# Log verbosity.
LOG_LEVEL=INFO

# Administrative master key — REQUIRED; the gateway fails closed without it.
# This example uses a non-secret placeholder so `docker compose config` renders;
# replace it with a strong, unique value in your local .env. Production keys are
# typically 'sk-'-prefixed high-entropy strings. Never commit a real key.
LITELLM_MASTER_KEY=REPLACE_WITH_LOCAL_MASTER_KEY
