# Integrated AI platform stack (ai/compose.yaml) — non-secret defaults.
# Copy to ai/.env (kept outside Git, mode 600) and set a real LITELLM_MASTER_KEY.

# Container timezone.
TZ=America/Chicago

# Pinned images. Confirm/update against tested releases before deploy.
OLLAMA_IMAGE=ollama/ollama:0.11.4
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-v1.74.3-stable

# Internal Ollama backend URL — private Docker network hostname. NOT an
# application endpoint; applications use the LiteLLM gateway on port 4000.
OLLAMA_BASE_URL=http://ollama:11434

# LiteLLM published gateway port and optional host bind address.
LITELLM_PORT=4000
LITELLM_BIND_ADDRESS=0.0.0.0

# Log verbosity.
LOG_LEVEL=INFO

# Administrative master key — REQUIRED at deploy time; the gateway fails closed.
# Leave BLANK in this template; set a strong, unique value in ai/.env.
# Deployment validation refuses to start without a non-empty key. Never commit
# a real key.
LITELLM_MASTER_KEY=
